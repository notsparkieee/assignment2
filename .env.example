# Environment Configuration Template
# Copy this file to .env and customize values

# ==========================================
# API Configuration
# ==========================================
APP_NAME="Vector Database Search System"
APP_VERSION="1.0.0"
DEBUG=true

# ==========================================
# Chunking Configuration
# ==========================================
# CHUNK_SIZE: Number of characters per chunk
# Why 512? Balance between context (larger) and precision (smaller)
# - Smaller (256): More precise matches but less context
# - Larger (1024): More context but less precise
# Recommendation: 512 for general documents, 1024 for legal/technical
CHUNK_SIZE=512

# CHUNK_OVERLAP: Number of overlapping characters between chunks
# Why overlap? Prevents losing context at chunk boundaries
# Example: "...diabetes." | "Treatment..." becomes "...diabetes. Treat" | "Treatment..."
# Recommendation: 10% of chunk size (50 for 512)
CHUNK_OVERLAP=50

# ==========================================
# Embedding Configuration
# ==========================================
# EMBEDDING_MODEL: Which sentence-transformer model to use
# Options:
#   - sentence-transformers/all-MiniLM-L6-v2 (default)
#     * Fast: 384 dimensions
#     * Good accuracy: 95% of BERT quality
#     * Size: 80MB
#     * Best for: Production, speed-critical apps
#
#   - sentence-transformers/all-mpnet-base-v2
#     * Slower: 768 dimensions
#     * Better accuracy: Best quality
#     * Size: 420MB
#     * Best for: Accuracy-critical apps
#
#   - sentence-transformers/paraphrase-MiniLM-L6-v2
#     * Fast: 384 dimensions
#     * Good for paraphrase detection
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# EMBEDDING_DIMENSION: Vector size (must match model output)
# Don't change unless you change the model
EMBEDDING_DIMENSION=384

# ==========================================
# Chroma Database Configuration
# ==========================================
# CHROMA_PERSIST_DIRECTORY: Where to store vector database
# Why persist? Data survives restarts (production requirement)
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# CHROMA_COLLECTION_NAME: Name of the vector collection
CHROMA_COLLECTION_NAME=documents

# ==========================================
# Search Configuration
# ==========================================
# DEFAULT_TOP_K: Default number of results to return
# Why 10? Standard in information retrieval, good balance
DEFAULT_TOP_K=10

# MAX_TOP_K: Maximum allowed results per query
# Why limit? Prevent expensive queries, diminishing returns after 50
MAX_TOP_K=100

# ==========================================
# API Configuration
# ==========================================
# CORS_ORIGINS: Allowed origins for CORS (comma-separated)
# Production: Set to specific domains like "https://yourapp.com"
# Development: Use "*" for all origins
CORS_ORIGINS=*
